---
import { sparklePath } from '../../data/sections';

interface Props {
  variant?: 'a' | 'b' | 'c' | 'd';
}

const { variant = 'a' } = Astro.props;

const sets = {
  a: {
    bubbles: [[92, 8, 90, 1], [4, 60, 54, 0], [80, 86, 32, 1], [48, 3, 20, 0]],
    sparkles: [[8, 12, 22, '#F6E3A1', 1], [70, 6, 16, '#8FF0F0', 0], [95, 55, 20, '#C9B8FF', 1], [30, 92, 14, '#FFFFFF', 0]],
    shards: [[96, 28, 46, -20, 'M2 20L40 4L34 58Z', 0], [1, 88, 52, 14, 'M10 4L44 22L26 62L2 40Z', 1]],
  },
  b: {
    bubbles: [[3, 10, 70, 1], [90, 70, 100, 1], [60, 94, 24, 0], [20, 88, 38, 0]],
    sparkles: [[88, 10, 24, '#C9B8FF', 1], [12, 50, 16, '#F6E3A1', 0], [50, 96, 18, '#8FF0F0', 1], [74, 40, 12, '#FFFFFF', 0]],
    shards: [[94, 6, 56, 18, 'M4 38L30 2L58 30L22 70Z', 1], [2, 70, 44, -12, 'M2 26L18 2L30 30L12 40Z', 0]],
  },
  c: {
    bubbles: [[94, 14, 56, 1], [2, 30, 84, 1], [70, 92, 40, 0], [42, 6, 18, 0]],
    sparkles: [[10, 8, 20, '#F6E3A1', 1], [90, 90, 24, '#FFFFFF', 1], [60, 4, 14, '#8FF0F0', 0], [4, 86, 16, '#C9B8FF', 0]],
    shards: [[88, 50, 50, 24, 'M4 50L24 2L56 36Z', 0], [97, 82, 40, -8, 'M2 20L40 4L34 58Z', 1]],
  },
  d: {
    bubbles: [[6, 20, 60, 1], [88, 40, 44, 0], [20, 90, 28, 1], [75, 8, 22, 0]],
    sparkles: [[50, 8, 22, '#F6E3A1', 1], [92, 20, 16, '#C9B8FF', 0], [8, 60, 18, '#8FF0F0', 1], [66, 76, 14, '#FFFFFF', 0]],
    shards: [[2, 6, 42, 10, 'M10 4L44 22L26 62L2 40Z', 0], [94, 70, 48, -16, 'M4 38L30 2L58 30L22 70Z', 1]],
  },
}[variant];
---

<div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
  {sets.shards.map(([x, y, s, r, d, m], i) => (
    <div class:list={['d-float absolute', !m && 'hidden md:block']} style={`left:${x}%;top:${y}%;width:${s}px;height:${s}px;--r:${r}deg;--dl:${i * 1.3}s`}>
      <svg class="d-shard h-full w-full overflow-visible" viewBox="0 0 60 72">
        <path d={d as string} fill="rgba(201,184,255,0.28)" stroke="#E4DAFF" stroke-width="2" stroke-linejoin="round" />
        <path d={d as string} fill="rgba(255,255,255,0.2)" transform="scale(0.45) translate(18 18)" />
      </svg>
    </div>
  ))}
  {sets.bubbles.map(([x, y, s, m], i) => (
    <div class:list={['d-float absolute', !m && 'hidden md:block']} style={`left:${x}%;top:${y}%;width:${s}px;height:${s}px;--dl:${i * 0.9}s`}>
      <span class="d-bubble block h-full w-full rounded-full"></span>
    </div>
  ))}
  {sets.sparkles.map(([x, y, s, c, m], i) => (
    <div class:list={['d-twinkle absolute', !m && 'hidden md:block']} style={`left:${x}%;top:${y}%;width:${s}px;height:${s}px;color:${c};--dl:${i * 0.7}s`}>
      <svg class="d-sparkle h-full w-full overflow-visible" viewBox="0 0 24 24">
        <path d={sparklePath} fill="currentColor" />
      </svg>
    </div>
  ))}
</div>

<style>
  .d-bubble {
    position: relative;
    background:
      radial-gradient(circle at 32% 28%, rgb(255 255 255 / 0.55) 0 7%, transparent 8%),
      radial-gradient(circle at 50% 50%, rgb(143 240 240 / 0.05) 0 55%, rgb(143 240 240 / 0.18) 78%, rgb(201 251 251 / 0.3) 100%);
    border: 2px solid rgb(203 251 251 / 0.45);
    box-shadow: 0 0 22px rgb(143 240 240 / 0.2), inset 0 0 14px rgb(143 240 240 / 0.14);
  }

  .d-shard {
    transform: rotate(var(--r));
    filter: drop-shadow(0 0 10px rgb(201 184 255 / 0.4));
  }

  .d-sparkle {
    filter: drop-shadow(0 0 6px currentColor);
  }

  @media (prefers-reduced-motion: no-preference) {
    .d-float {
      animation: d-float 7s ease-in-out infinite alternate;
      animation-delay: var(--dl);
    }

    .d-twinkle {
      animation: d-twinkle 2.8s ease-in-out infinite alternate;
      animation-delay: var(--dl);
    }
  }

  @keyframes d-float {
    from { transform: translateY(0); }
    to { transform: translateY(-18px); }
  }

  @keyframes d-twinkle {
    from { transform: scale(0.6); opacity: 0.5; }
    to { transform: scale(1); opacity: 1; }
  }
</style>
