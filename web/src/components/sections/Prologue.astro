---
import { Image } from 'astro:assets';
import type { Lang } from '../../i18n/ui';
import { stats, education, about } from '../../data/content';
import { st, sparklePath } from '../../data/sections';
import portrait from '../../assets/photos/foto2heaven.jpeg';
import SectionHead from './SectionHead.astro';
import Scene from '../stage/Scene.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = st(lang).prologue;

const cards = stats.map((s) => {
  const m = s.value.match(/^(\d+(?:\.\d+)?)(\s?[+%])$/);
  return {
    label: s.label[lang],
    value: s.value,
    count: m ? Number(m[1]) : null,
    decimals: m && m[1].includes('.') ? m[1].split('.')[1].length : 0,
    suffix: m ? m[2] : '',
  };
});
---

<section id="sobre-mi" class="prologue relative isolate overflow-hidden py-20 sm:py-28" aria-labelledby="sobre-mi-title" data-prologue>
  <Scene name="prologue" />
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-8">
    <SectionHead id="sobre-mi-title" label={t.label} title={t.title} />

    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
      <figure class="polaroid relative mx-auto w-full max-w-[19rem] sm:max-w-sm" data-reveal>
        <div class="frame rounded-[26px] border-2 border-cream/60 bg-cream-100 p-3 pb-4 sm:p-4 sm:pb-5">
          <div class="relative aspect-[4/5] overflow-hidden rounded-[16px] bg-night-800">
            <Image
              src={portrait}
              alt={t.photoAlt}
              widths={[320, 480, 640]}
              sizes="(min-width: 640px) 24rem, 19rem"
              class="h-full w-full object-cover object-[50%_62%]"
              loading="lazy"
            />
          </div>
          <figcaption class="mt-3 flex items-center justify-between font-mono text-[0.7rem] font-semibold tracking-[0.18em] text-night-800 uppercase">
            <span>{t.photoCaption}</span>
            <span>JDHVA</span>
          </figcaption>
        </div>
        <svg class="spark-a absolute -top-5 -right-4 h-12 w-12 text-cream" viewBox="0 0 24 24" aria-hidden="true">
          <path d={sparklePath} fill="currentColor" />
        </svg>
        <svg class="spark-b absolute -bottom-4 -left-5 h-8 w-8 text-aqua" viewBox="0 0 24 24" aria-hidden="true">
          <path d={sparklePath} fill="currentColor" />
        </svg>
      </figure>

      <div class="flex flex-col gap-6">
        <div class="flex flex-col gap-4 text-lg leading-relaxed text-ink/90 sm:text-xl">
          {t.bio.map((p, i) => (
            <p class:list={[i === 0 && 'font-display text-2xl font-medium text-cream-100 sm:text-3xl']} data-reveal>{p}</p>
          ))}
        </div>

        <p class="edu flex flex-wrap items-center gap-x-3 gap-y-1 text-base text-lavender-100 sm:text-lg" data-reveal>
          <span class="rounded-full border-2 border-lavender-200/50 bg-lavender-400/10 px-3 py-0.5 font-mono text-[0.7rem] font-semibold tracking-[0.18em] text-lavender-200 uppercase">{t.studying}</span>
          <span>{education.degree[lang]} · {education.school} · {education.status[lang]}</span>
        </p>

        <p class="learn flex flex-wrap items-center gap-x-3 gap-y-1 text-base text-lavender-100 sm:text-lg" data-reveal>
          <span class="rounded-full border-2 border-cream/50 bg-cream/10 px-3 py-0.5 font-mono text-[0.7rem] font-semibold tracking-[0.18em] text-cream uppercase">{t.learning}</span>
          <span>{about.learning[lang].replace(/^[^:]+:\s*/, '')}</span>
        </p>

        <p class="now inline-flex w-fit max-w-full flex-wrap items-center gap-x-3 gap-y-1 rounded-full border-2 border-aqua/50 bg-aqua/10 px-4 py-2 text-aqua" data-reveal>
          <span class="inline-flex items-center gap-2 font-mono text-[0.7rem] font-semibold tracking-[0.18em] uppercase">
            <span class="live-dot inline-block h-2 w-2 rounded-full bg-aqua"></span>
            {t.nowLabel}
          </span>
          <span class="text-sm font-medium text-aqua-100 sm:text-base">{t.now}</span>
        </p>
      </div>
    </div>

    <ul class="mt-14 grid grid-cols-2 gap-4 sm:mt-20 sm:gap-6 lg:grid-cols-4" aria-label={t.statsLabel}>
      {cards.map((c, i) => (
        <li class="stage-card flex flex-col gap-2 px-4 py-5 sm:px-6 sm:py-7" data-reveal>
          <span
            class:list={[
              'stat-value font-display text-3xl font-semibold sm:text-5xl',
              ['text-cream', 'text-aqua', 'text-lavender-200', 'text-water-200'][i % 4],
            ]}
            data-count={c.count ?? undefined}
            data-decimals={c.count !== null ? c.decimals : undefined}
            data-suffix={c.count !== null ? c.suffix : undefined}
            data-pop={c.count === null ? '' : undefined}
          >{c.value}</span>
          <span class="text-sm leading-snug text-lavender-100 sm:text-base">{c.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .frame {
    transform: rotate(-2.5deg);
    box-shadow: 0 8px 0 #C9A956, 0 22px 44px rgb(8 8 30 / 0.5);
  }

  .live-dot {
    box-shadow: 0 0 10px #8FF0F0;
  }

  .spark-a,
  .spark-b {
    filter: drop-shadow(0 0 8px currentColor);
  }

  @media (prefers-reduced-motion: no-preference) {
    .live-dot {
      animation: pulse 1.6s ease-in-out infinite;
    }

    .spark-a {
      animation: twirl 5s ease-in-out infinite alternate;
    }

    .spark-b {
      animation: twirl 4s ease-in-out infinite alternate-reverse;
    }
  }

  @keyframes pulse {
    50% { opacity: 0.35; transform: scale(0.7); }
  }

  @keyframes twirl {
    from { transform: scale(0.8) rotate(-12deg); }
    to { transform: scale(1.1) rotate(12deg); }
  }
</style>

<script>
  import { gsap, reveal, reduceMotion, ScrollTrigger } from './reveal';

  document.querySelectorAll<HTMLElement>('[data-prologue]').forEach((root) => {
    reveal(root);
    const fmt = (n: number, d: number) => n.toFixed(d);
    root.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const target = Number(el.dataset.count);
      const d = Number(el.dataset.decimals ?? 0);
      const suffix = el.dataset.suffix ?? '';
      if (reduceMotion()) return;
      el.textContent = fmt(0, d) + suffix;
      const o = { v: 0 };
      ScrollTrigger.create({
        trigger: el,
        start: 'top 90%',
        once: true,
        onEnter: () => {
          gsap.to(o, {
            v: target,
            duration: 1.8,
            ease: 'power2.out',
            onUpdate: () => {
              el.textContent = fmt(o.v, d) + suffix;
            },
            onComplete: () => {
              el.textContent = fmt(target, d) + suffix;
            },
          });
        },
      });
    });
    if (!reduceMotion()) {
      root.querySelectorAll<HTMLElement>('[data-pop]').forEach((el) => {
        gsap.set(el, { scale: 0.6, opacity: 0, transformOrigin: 'left center' });
        ScrollTrigger.create({
          trigger: el,
          start: 'top 90%',
          once: true,
          onEnter: () => {
            gsap.to(el, { scale: 1, opacity: 1, duration: 0.9, delay: 0.2, ease: 'back.out(2.2)' });
          },
        });
      });
    }
  });
</script>
