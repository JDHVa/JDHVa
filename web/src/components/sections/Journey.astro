---
import type { Lang } from '../../i18n/ui';
import { experience, education } from '../../data/content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { st, sparklePath } from '../../data/sections';
import SectionHead from './SectionHead.astro';
import Scene from '../stage/Scene.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = st(lang).journey;
const evid = import.meta.glob<ImageMetadata>('/src/assets/evidencias/*.{jpeg,jpg,png}', { eager: true, import: 'default' });
const imgOf = (p?: string) => (p ? evid[`/src/assets/${p}`] : undefined);
---

<section id="trayectoria" class="relative isolate overflow-hidden py-20 sm:py-28" aria-labelledby="trayectoria-title" data-journey>
  <Scene name="journey" />
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-8">
    <SectionHead id="trayectoria-title" label={t.label} title={t.title} />

    <ol class="stage relative mx-auto flex max-w-3xl flex-col gap-8 sm:gap-10">
      <span class="line pointer-events-none absolute top-3 bottom-3 left-[1.1rem] w-1 rounded-full sm:left-[1.4rem]" aria-hidden="true" data-line></span>
      {experience.map((r, i) => (
        <li class="relative pl-14 sm:pl-[4.5rem]" data-reveal>
          <span
            class:list={[
              'node absolute top-5 left-0 flex h-9 w-9 items-center justify-center rounded-full border-2 sm:h-11 sm:w-11',
              i === 0 ? 'border-cream bg-cream text-night-900' : 'border-lavender-200/60 bg-night-950 text-lavender-200',
            ]}
            aria-hidden="true"
          >
            <svg class="h-4 w-4 sm:h-5 sm:w-5" viewBox="0 0 24 24"><path d={sparklePath} fill="currentColor" /></svg>
          </span>
          <article
            class:list={[
              'stage-card px-5 py-5 sm:px-7 sm:py-6',
              i === 0 && 'featured border-cream/60',
            ]}
          >
            {i === 0 && (
              <p class="mb-2 inline-flex items-center gap-2 rounded-full bg-cream px-3 py-0.5 font-mono text-[0.65rem] font-bold tracking-[0.18em] text-night-900 uppercase">
                {t.current}
              </p>
            )}
            <p class="font-mono text-xs font-semibold tracking-[0.14em] text-aqua uppercase sm:text-sm">{r.org}</p>
            {r.period && <p class="mt-1 font-mono text-xs font-semibold tracking-wide text-cream-100/90">{r.period[lang]}</p>}
            <h3 class:list={['mt-1 font-display font-semibold text-cream', i === 0 ? 'text-3xl sm:text-4xl' : 'text-2xl sm:text-3xl']}>{r.title[lang]}</h3>
            <p class="mt-2 text-base leading-relaxed text-ink/90 sm:text-lg">{r.description[lang]}</p>
            {imgOf(r.image) && (
              <Image
                src={imgOf(r.image)!}
                alt=""
                widths={[480, 800]}
                sizes="(min-width: 768px) 640px, 90vw"
                class="mt-4 aspect-[16/9] w-full rounded-2xl border-2 border-lavender-200/30 object-cover"
                loading="lazy"
              />
            )}
          </article>
        </li>
      ))}
      <li class="relative pl-14 sm:pl-[4.5rem]" data-reveal>
        <span class="node absolute top-5 left-0 flex h-9 w-9 items-center justify-center rounded-full border-2 border-aqua bg-aqua text-night-900 sm:h-11 sm:w-11" aria-hidden="true">
          <svg class="h-4 w-4 sm:h-5 sm:w-5" viewBox="0 0 24 24"><path d="M12 3 1 9l11 6 9-4.9V17h2V9L12 3ZM5 13.2V17c0 1.7 3.1 3 7 3s7-1.3 7-3v-3.8l-7 3.8-7-3.8Z" fill="currentColor" /></svg>
        </span>
        <article class="stage-card edu-card px-5 py-5 sm:px-7 sm:py-6">
          <p class="inline-flex rounded-full bg-aqua px-3 py-0.5 font-mono text-[0.65rem] font-bold tracking-[0.18em] text-night-900 uppercase">{t.education}</p>
          <h3 class="mt-2 font-display text-2xl font-semibold text-cream sm:text-3xl">{education.degree[lang]}</h3>
          <p class="mt-1 font-mono text-xs font-semibold tracking-[0.14em] text-aqua uppercase sm:text-sm">{education.school} · {education.status[lang]}</p>
          <p class="mt-2 text-base leading-relaxed text-ink/90 sm:text-lg">{education.schoolFull}</p>
        </article>
      </li>
    </ol>
  </div>
</section>

<style>
  .line {
    background: linear-gradient(180deg, #F6E3A1 0%, #C9B8FF 30%, #6FA8FF 100%);
    opacity: 0.55;
    transform-origin: top;
  }

  .node {
    box-shadow: 0 4px 0 rgb(91 73 201 / 0.6);
  }

  .edu-card {
    border-style: dashed;
    border-color: rgb(143 240 240 / 0.55);
    box-shadow: 0 8px 0 rgb(63 185 185 / 0.5), 0 18px 40px rgb(8 8 30 / 0.45);
  }

  .featured {
    background: linear-gradient(135deg, rgb(58 37 133 / 0.85), rgb(19 20 64 / 0.85));
    box-shadow: 0 8px 0 #C9A956, 0 18px 40px rgb(8 8 30 / 0.45), 0 0 50px rgb(246 227 161 / 0.12);
  }
</style>

<script>
  import { gsap, reveal, reduceMotion, ScrollTrigger } from './reveal';

  document.querySelectorAll<HTMLElement>('[data-journey]').forEach((root) => {
    reveal(root);
    const line = root.querySelector<HTMLElement>('[data-line]');
    if (line && !reduceMotion()) {
      gsap.fromTo(
        line,
        { scaleY: 0 },
        { scaleY: 1, ease: 'none', scrollTrigger: { trigger: line.parentElement, start: 'top 70%', end: 'bottom 92%', scrub: 0.6 } },
      );
    }
    window.addEventListener('load', () => ScrollTrigger.refresh());
  });
</script>
