---
import type { ProjectId } from '../../data/content';
import type { ActStrings } from './strings';

interface Props {
  id: ProjectId;
  s: ActStrings;
}

const { id, s } = Astro.props;

const sparklePath = 'M12 0C12.9 7.4 16.6 11.1 24 12C16.6 12.9 12.9 16.6 12 24C11.1 16.6 7.4 12.9 0 12C7.4 11.1 11.1 7.4 12 0Z';

const lumenBubbles = [
  { x: 122, y: 104, r: 34, c: '#8FF0F0' },
  { x: 262, y: 88, r: 28, c: '#9EC9FF' },
  { x: 298, y: 186, r: 32, c: '#C9B8FF' },
  { x: 196, y: 226, r: 27, c: '#8EE6A8' },
  { x: 96, y: 196, r: 22, c: '#FF7FA8' },
];
const center = { x: 200, y: 150 };
const lumenLinks = lumenBubbles.map((b, i) => {
  const n = lumenBubbles[(i + 1) % lumenBubbles.length];
  return { x1: b.x, y1: b.y, x2: n.x, y2: n.y };
});
const lumenSpokes = lumenBubbles.map((b) => ({ x1: b.x, y1: b.y, x2: center.x, y2: center.y }));
const lumenOffsets = lumenBubbles.map((b) => {
  const dx = b.x - center.x;
  const dy = b.y - center.y;
  const len = Math.hypot(dx, dy) || 1;
  return { dx: Math.round((dx / len) * 70), dy: Math.round((dy / len) * 50) };
});

const plantCols = 5;
const plantRows = 3;
const plants: { x: number; y: number }[] = [];
for (let r = 0; r < plantRows; r++) {
  for (let c = 0; c < plantCols; c++) {
    plants.push({ x: 72 + c * 64 + (r % 2 ? 22 : 0), y: 84 + r * 62 });
  }
}
const plantEdges: [number, number][] = [];
plants.forEach((a, i) => {
  plants.forEach((b, j) => {
    if (j > i && Math.hypot(a.x - b.x, a.y - b.y) < 80) plantEdges.push([i, j]);
  });
});
const origin = 12;
const dist = plants.map(() => Infinity);
dist[origin] = 0;
const queue = [origin];
while (queue.length) {
  const cur = queue.shift()!;
  plantEdges.forEach(([a, b]) => {
    const nxt = a === cur ? b : b === cur ? a : -1;
    if (nxt >= 0 && dist[nxt] === Infinity) {
      dist[nxt] = dist[cur] + 1;
      queue.push(nxt);
    }
  });
}

const bars = Array.from({ length: 17 }, (_, i) => {
  const h = 10 + Math.round(Math.abs(Math.sin(i * 1.7) * 34) + Math.abs(Math.cos(i * 0.6) * 14));
  return { x: 52 + i * 6, h };
});

const trackPath = 'M34 236C92 240 104 150 160 128S236 150 252 196S330 246 352 190S338 84 290 70S190 58 150 64';
---

<div class="motif-stage relative aspect-[4/3] w-full" data-motif={id} data-stage role="img" aria-label={s.motif[id as keyof typeof s.motif]}>
  <span class="stage-spot" aria-hidden="true"></span>
  <span class="stage-glow" aria-hidden="true"></span>
  <svg class="motif-svg relative h-full w-full overflow-visible" viewBox="0 0 400 300" aria-hidden="true">
    <defs>
      <radialGradient id={`bub-${id}`} cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#8FF0F0" stop-opacity="0.04" />
        <stop offset="70%" stop-color="#8FF0F0" stop-opacity="0.16" />
        <stop offset="100%" stop-color="#CBFBFB" stop-opacity="0.38" />
      </radialGradient>
    </defs>

    <ellipse cx="200" cy="282" rx="170" ry="14" fill="#131440" opacity="0.55" />

    {id === 'lumen' && (
      <g>
        <g data-l-lines>
          {lumenLinks.map((l) => (
            <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke="#F6E3A1" stroke-width="3" stroke-linecap="round" stroke-dasharray="1 9" data-l-line />
          ))}
          {lumenSpokes.map((l) => (
            <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke="#FBF1CF" stroke-width="2.5" stroke-linecap="round" opacity="0.7" data-l-line />
          ))}
        </g>
        {lumenBubbles.map((b, i) => (
          <g data-l-bubble data-dx={lumenOffsets[i].dx} data-dy={lumenOffsets[i].dy}>
            <g data-l-float>
              <circle cx={b.x} cy={b.y} r={b.r} fill={`url(#bub-${id})`} stroke={b.c} stroke-width="3" />
              <circle cx={b.x - b.r * 0.36} cy={b.y - b.r * 0.4} r={b.r * 0.13} fill="#FFFFFF" opacity="0.75" />
              <path d={`M${b.x + b.r * 0.25} ${b.y - b.r * 0.62}A${b.r * 0.62} ${b.r * 0.62} 0 0 1 ${b.x + b.r * 0.62} ${b.y - b.r * 0.2}`} fill="none" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" opacity="0.7" />
              <circle cx={b.x} cy={b.y} r={b.r * 0.22} fill={b.c} opacity="0.85" />
            </g>
          </g>
        ))}
        <g data-l-core>
          <circle cx={center.x} cy={center.y} r="30" fill="none" stroke="#F6E3A1" stroke-width="3" opacity="0.5" />
          <circle cx={center.x} cy={center.y} r="21" fill="#2A2470" stroke="#F6E3A1" stroke-width="3" />
          <path d={sparklePath} fill="#F6E3A1" transform={`translate(${center.x - 14} ${center.y - 14}) scale(1.17)`} />
        </g>
        <g fill="#FFFFFF" data-l-sparks>
          <path d={sparklePath} transform="translate(330 40) scale(0.7)" opacity="0.85" />
          <path d={sparklePath} transform="translate(46 54) scale(0.5)" fill="#8FF0F0" />
          <path d={sparklePath} transform="translate(352 244) scale(0.55)" fill="#C9B8FF" />
        </g>
      </g>
    )}

    {id === 'terraorbis' && (
      <g>
        <g data-t-leaves>
          {[
            { x: 22, y: 26, r: -30, s: 1 },
            { x: 352, y: 22, r: 40, s: 0.8 },
            { x: 360, y: 236, r: 160, s: 0.9 },
            { x: 12, y: 222, r: -150, s: 0.7 },
          ].map((l) => (
            <g transform={`translate(${l.x} ${l.y}) rotate(${l.r}) scale(${l.s})`}>
              <g data-t-leaf>
                <path d="M0 0C14 -18 40 -18 52 0C40 18 14 18 0 0Z" fill="#8EE6A8" stroke="#CFF5DA" stroke-width="2.5" stroke-linejoin="round" />
                <path d="M4 0H46M18 0L26 -8M30 0L38 -7M18 0L26 8M30 0L38 7" stroke="#3E9E6A" stroke-width="2.2" stroke-linecap="round" fill="none" />
              </g>
            </g>
          ))}
        </g>
        <g stroke="#CFF5DA" stroke-width="2" stroke-linecap="round" opacity="0.35">
          {plantEdges.map(([a, b]) => (
            <line x1={plants[a].x} y1={plants[a].y} x2={plants[b].x} y2={plants[b].y} />
          ))}
        </g>
        <g data-t-ring>
          <circle cx={plants[origin].x} cy={plants[origin].y} r="30" fill="none" stroke="#8FF0F0" stroke-width="3" stroke-dasharray="7 6" />
          <circle cx={plants[origin].x} cy={plants[origin].y} r="38" fill="none" stroke="#8FF0F0" stroke-width="1.5" opacity="0.5" />
        </g>
        {plants.map((p, i) => (
          <g data-t-node data-dist={dist[i]}>
            <circle cx={p.x} cy={p.y} r="15" fill="#24504A" stroke="#8EE6A8" stroke-width="2.5" />
            <circle cx={p.x} cy={p.y} r="15" fill="#6B5A1E" stroke="#F6E3A1" stroke-width="2.5" opacity={dist[i] === 1 ? 1 : 0} data-t-e />
            <circle cx={p.x} cy={p.y} r="15" fill="#6A2342" stroke="#FF7FA8" stroke-width="2.5" opacity={dist[i] === 0 ? 1 : 0} data-t-i />
            <path d={`M${p.x} ${p.y + 7}V${p.y - 2}`} stroke="#CFF5DA" stroke-width="2.2" stroke-linecap="round" />
            <path d={`M${p.x} ${p.y - 1}C${p.x - 2} ${p.y - 9} ${p.x - 9} ${p.y - 9} ${p.x - 10} ${p.y - 6}C${p.x - 8} ${p.y - 2} ${p.x - 3} ${p.y - 1} ${p.x} ${p.y - 1}Z`} fill="#CFF5DA" />
            <path d={`M${p.x} ${p.y - 3}C${p.x + 2} ${p.y - 11} ${p.x + 9} ${p.y - 11} ${p.x + 10} ${p.y - 8}C${p.x + 8} ${p.y - 4} ${p.x + 3} ${p.y - 3} ${p.x} ${p.y - 3}Z`} fill="#CFF5DA" />
          </g>
        ))}
        <g data-t-tag>
          <rect x={plants[origin].x - 40} y={plants[origin].y + 34} width="80" height="20" rx="10" fill="#131440" stroke="#8FF0F0" stroke-width="2" />
          <text x={plants[origin].x} y={plants[origin].y + 48} text-anchor="middle" class="motif-mono" fill="#8FF0F0">{s.detected}</text>
        </g>
        <g class="motif-mono" font-size="12">
          {[
            { k: 'S', c: '#8EE6A8' },
            { k: 'E', c: '#F6E3A1' },
            { k: 'I', c: '#FF7FA8' },
            { k: 'R', c: '#C9B8FF' },
          ].map((it, i) => (
            <g transform={`translate(${128 + i * 40} 284)`}>
              <circle cx="0" cy="-4" r="5" fill={it.c} />
              <text x="9" y="0" fill="#E9ECFF">{it.k}</text>
            </g>
          ))}
        </g>
      </g>
    )}

    {id === 'centinel' && (
      <g>
        <g data-c-phone>
          <rect x="34" y="28" width="132" height="236" rx="24" fill="#2A2470" stroke="#C9B8FF" stroke-width="3" />
          <rect x="46" y="48" width="108" height="196" rx="14" fill="#131440" />
          <rect x="82" y="36" width="36" height="6" rx="3" fill="#C9B8FF" opacity="0.6" />
          <circle cx="100" cy="84" r="16" fill="#3A3192" stroke="#9B8CFF" stroke-width="2" />
          <path d="M92 90c2-6 14-6 16 0M95 80a5 5 0 1 0 10 0a5 5 0 1 0 -10 0" fill="none" stroke="#E4DAFF" stroke-width="2" stroke-linecap="round" />
          <g data-c-wave>
            {bars.map((b) => (
              <rect x={b.x} y={150 - b.h / 2} width="4" height={b.h} rx="2" fill="#8FF0F0" data-c-bar />
            ))}
          </g>
          <g class="motif-mono" font-size="13" font-weight="700" text-anchor="middle">
            <g data-c-say="human">
              <rect x="62" y="206" width="76" height="24" rx="12" fill="#A98BFF" />
              <text x="100" y="222" fill="#131440">{s.device.human}</text>
            </g>
            <g data-c-say="verify" opacity="0">
              <rect x="62" y="206" width="76" height="24" rx="12" fill="#F6E3A1" />
              <text x="100" y="222" fill="#131440">· · ·</text>
            </g>
            <g data-c-say="ai" opacity="0">
              <rect x="62" y="206" width="76" height="24" rx="12" fill="#FF5C6C" />
              <text x="100" y="222" fill="#131440">{s.device.ai}</text>
            </g>
          </g>
        </g>
        <g>
          <rect x="232" y="46" width="62" height="190" rx="22" fill="#2A2470" stroke="#E4DAFF" stroke-width="3" />
          <rect x="257" y="236" width="12" height="34" fill="#3A3192" />
          {[
            { k: 'hang', y: 84, c: '#FF5C6C', label: s.light.hang },
            { k: 'verify', y: 141, c: '#F6E3A1', label: s.light.verify },
            { k: 'continue', y: 198, c: '#A98BFF', label: s.light.continue },
          ].map((l) => (
            <g>
              <circle cx="263" cy={l.y} r="20" fill="#131440" stroke={l.c} stroke-width="2" opacity="0.9" />
              <g data-c-lamp={l.k} opacity={l.k === 'continue' ? 1 : 0.12}>
                <circle cx="263" cy={l.y} r="26" fill={l.c} opacity="0.25" />
                <circle cx="263" cy={l.y} r="18" fill={l.c} />
                <circle cx="256" cy={l.y - 7} r="4.5" fill="#FFFFFF" opacity="0.7" />
              </g>
              <text x="304" y={l.y + 4} class="motif-mono" font-size="12" fill="#E9ECFF">{l.label}</text>
            </g>
          ))}
        </g>
      </g>
    )}

    {id === 'trackmania' && (
      <g>
        <path d={trackPath} transform="translate(-10 -22)" fill="none" stroke="#C9B8FF" stroke-width="3" stroke-dasharray="2 10" stroke-linecap="round" opacity="0.55" />
        <g fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path d={trackPath} stroke="#CFE4FF" stroke-width="38" />
          <path d={trackPath} stroke="#FF7FA8" stroke-width="38" stroke-dasharray="10 10" />
          <path d={trackPath} stroke="#2A2470" stroke-width="30" />
          <path d={trackPath} stroke="#3A3192" stroke-width="12" opacity="0.6" />
          <path d={trackPath} stroke="#F6E3A1" stroke-width="2.5" stroke-dasharray="12 12" opacity="0.8" />
        </g>
        <g class="motif-mono" font-size="10" font-weight="700">
          {[
            { x: 160, y: 128, r: 70 },
            { x: 300, y: 228, r: -20 },
            { x: 346, y: 128, r: 6 },
          ].map((cp, i) => (
            <g transform={`translate(${cp.x} ${cp.y}) rotate(${cp.r})`}>
              <rect x="-3" y="-22" width="6" height="44" rx="3" fill="#8FF0F0" opacity="0.85" />
            </g>
          ))}
        </g>
        <g transform="translate(26 210)">
          <rect x="0" y="0" width="4" height="34" fill="#E9ECFF" />
          <path d="M4 0h22v14H4z" fill="#FFFFFF" />
          <path d="M4 0h5.5v3.5H4zM15 0h5.5v3.5H15zM9.5 3.5H15V7H9.5zM20.5 3.5H26V7h-5.5zM4 7h5.5v3.5H4zM15 7h5.5v3.5H15zM9.5 10.5H15V14H9.5zM20.5 10.5H26V14h-5.5z" fill="#131440" />
        </g>
        <g transform="translate(144 40)">
          <rect x="0" y="0" width="4" height="34" fill="#E9ECFF" />
          <path d="M4 0h22v14H4z" fill="#F6E3A1" />
        </g>
        <path id="tm-path" d={trackPath} fill="none" stroke="none" />
        <g data-k-car transform="translate(150 64) rotate(184)">
          <g transform="translate(-13 -8)">
            <rect x="0" y="0" width="26" height="16" rx="6" fill="#8FF0F0" stroke="#CBFBFB" stroke-width="2" />
            <rect x="9" y="3" width="9" height="10" rx="3" fill="#131440" />
            <rect x="22" y="2" width="4" height="12" rx="2" fill="#F6E3A1" />
            <rect x="2" y="-3" width="7" height="4" rx="2" fill="#131440" />
            <rect x="2" y="15" width="7" height="4" rx="2" fill="#131440" />
            <rect x="17" y="-3" width="7" height="4" rx="2" fill="#131440" />
            <rect x="17" y="15" width="7" height="4" rx="2" fill="#131440" />
          </g>
        </g>
        <g fill="#C9B8FF" opacity="0.85">
          <path d={sparklePath} transform="translate(358 30) scale(0.7)" fill="#F6E3A1" />
          <path d={sparklePath} transform="translate(40 40) scale(0.5)" />
          <circle cx="210" cy="250" r="3" />
          <circle cx="90" cy="120" r="2.5" />
        </g>
      </g>
    )}
  </svg>
</div>

<style>
  .motif-stage {
    border-radius: 32px;
    background:
      radial-gradient(60% 55% at 50% 30%, color-mix(in srgb, var(--accent) 16%, transparent) 0%, transparent 70%),
      linear-gradient(180deg, #22236A 0%, #1B1D4F 100%);
    border: 2px solid color-mix(in srgb, var(--accent) 35%, transparent);
    box-shadow: 0 8px 0 color-mix(in srgb, var(--accent-deep) 55%, #131440), 0 18px 40px rgb(8 8 30 / 0.45);
    overflow: hidden;
  }

  .stage-spot {
    position: absolute;
    left: 50%;
    top: -10%;
    width: 70%;
    height: 120%;
    transform: translateX(-50%);
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 14%, transparent), transparent 80%);
    clip-path: polygon(40% 0, 60% 0, 100% 100%, 0 100%);
    pointer-events: none;
  }

  .stage-glow {
    position: absolute;
    left: 50%;
    top: 46%;
    width: 64%;
    aspect-ratio: 1;
    border-radius: 50%;
    translate: -50% -50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 22%, transparent), transparent);
    opacity: 0.5;
    pointer-events: none;
  }

  @media (min-width: 1024px) {
    .motif-stage {
      border-radius: 40px;
      border-width: 3px;
    }

    .motif-svg {
      transform: scale(1.07);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .stage-spot {
      transform-origin: 50% 0;
      animation: spot-sway 7s ease-in-out infinite alternate;
    }

    .stage-glow {
      animation: glow-breathe 4.5s ease-in-out infinite alternate;
    }

    :global(.js) .motif-stage:not(:global(.is-live)) .stage-spot,
    :global(.js) .motif-stage:not(:global(.is-live)) .stage-glow {
      animation-play-state: paused;
    }
  }

  @keyframes spot-sway {
    from { rotate: -7deg; }
    to { rotate: 7deg; }
  }

  @keyframes glow-breathe {
    from { opacity: 0.35; scale: 0.9; }
    to { opacity: 0.85; scale: 1.08; }
  }

  .motif-mono {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }
</style>
