---
import type { Lang } from '../../i18n/ui';
import type { Metric } from '../../data/content';
import { parseCount } from './strings';

interface Props {
  lang: Lang;
  items: Metric[];
}

const { lang, items } = Astro.props;
const cols = items.length === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2 xl:grid-cols-4';
---

<ul class:list={['grid grid-cols-2 gap-3 sm:gap-4', cols]}>
  {items.map((m) => {
    const count = parseCount(m.value);
    return (
      <li class="metric-card relative flex flex-col gap-1.5 rounded-3xl px-4 py-4 sm:px-5 sm:py-5" data-reveal="pop">
        <span class="metric-value font-display font-semibold leading-none text-cream-100">
          {count ? (
            <>
              <span class="sr-only">{m.value}</span>
              <span aria-hidden="true">
                {count.prefix}
                <span data-count={count.number} data-decimals={count.decimals}>{m.value.slice(count.prefix.length, m.value.length - count.suffix.length)}</span>
                <span class="metric-unit">{count.suffix}</span>
              </span>
            </>
          ) : (
            <span data-fade>{m.value}</span>
          )}
        </span>
        <span class="text-sm leading-snug text-ink/85">{m.label[lang]}</span>
        {m.note && <span class="font-mono text-[0.68rem] leading-snug tracking-wide text-lavender-200">{m.note[lang]}</span>}
      </li>
    );
  })}
</ul>

<style>
  .metric-card {
    background: linear-gradient(160deg, rgb(42 36 112 / 0.85), rgb(19 20 64 / 0.85));
    border: 2px solid color-mix(in srgb, var(--accent) 30%, transparent);
    box-shadow: 0 6px 0 color-mix(in srgb, var(--accent-deep) 45%, #131440);
  }

  .metric-value {
    font-size: clamp(1.7rem, 4.4vw, 2.6rem);
    color: var(--accent-soft);
    text-shadow: 0 0.07em 0 color-mix(in srgb, var(--accent-deep) 80%, #131440);
    font-variant-numeric: tabular-nums;
  }

  .metric-unit {
    font-size: 0.55em;
    margin-left: 0.08em;
    opacity: 0.85;
  }
</style>
