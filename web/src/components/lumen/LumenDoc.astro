---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ownerName, type Lang } from '../../i18n/ui';
import logo from '../../assets/evidencias/lumen-logo-light.png';
import { Content, getHeadings } from '../../content/lumen/documentacion.md';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const es = lang === 'es';

const copy = {
  back: es ? '← Volver al portafolio' : '← Back to portfolio',
  title: 'Proyecto Lumen · Documentación oficial',
  version: 'Versión 1.0 — Agosto 2026',
  callout: es
    ? 'Esta documentación es abierta para que cualquier escuela pueda replicar Lumen.'
    : 'This documentation is open so any school can replicate Lumen. The document is in Spanish.',
  print: es ? 'Descargar / Imprimir' : 'Download / Print',
  toc: es ? 'Contenido' : 'Contents',
  lang: es ? 'Idioma' : 'Language',
  role: es ? 'Coordinador del proyecto' : 'Project coordinator',
  tagline: 'Creemos en tu potencial, a tu propio ritmo.',
  metaDescription: es
    ? 'Documentación oficial de Proyecto Lumen, red estudiantil de apoyo académico entre pares en la EIAO.'
    : 'Official documentation of Proyecto Lumen, a peer-to-peer student support network at EIAO. The document is in Spanish.',
};

const backHref = es ? getRelativeLocaleUrl('es') : `${getRelativeLocaleUrl('en')}#act-lumen`;
const esHref = getRelativeLocaleUrl('es', 'lumen/');
const enHref = getRelativeLocaleUrl('en', 'lumen/');
const headings = getHeadings().filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout lang={lang} title={copy.title} description={copy.metaDescription}>
  <div class="lumen-page relative z-10 mx-auto w-full max-w-6xl px-4 pb-24 sm:px-8">
    <header class="topbar flex items-center justify-between gap-4 py-5 sm:py-6">
      <a
        href={backHref}
        class="group inline-flex items-center rounded-full border-2 border-lavender-200/40 bg-night-950/55 px-4 py-2 font-mono text-xs font-semibold text-lavender-100 transition-colors hover:text-cream"
      >
        {copy.back}
      </a>
      <nav aria-label={copy.lang}>
        <ul class="flex items-center rounded-full border-2 border-lavender-200/40 bg-night-950/55 p-1 font-mono text-xs font-semibold">
          <li>
            <a
              href={esHref}
              hreflang="es"
              lang="es"
              aria-current={es ? 'page' : undefined}
              class:list={['block rounded-full px-3 py-1.5 transition-colors', es ? 'bg-cream text-night-900' : 'text-lavender-100 hover:text-cream']}
            >
              <span aria-hidden="true">ES</span>
              <span class="sr-only">Español</span>
            </a>
          </li>
          <li>
            <a
              href={enHref}
              hreflang="en"
              lang="en"
              aria-current={!es ? 'page' : undefined}
              class:list={['block rounded-full px-3 py-1.5 transition-colors', !es ? 'bg-cream text-night-900' : 'text-lavender-100 hover:text-cream']}
            >
              <span aria-hidden="true">EN</span>
              <span class="sr-only">English</span>
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <section class="doc-head mt-4 flex flex-col gap-6 rounded-[2rem] border-2 border-lavender-200/25 bg-night-800/45 p-6 sm:flex-row sm:items-center sm:gap-8 sm:p-10">
      <div class="logo-wrap h-24 w-24 shrink-0 overflow-hidden rounded-3xl border-2 border-cream/60 sm:h-32 sm:w-32">
        <Image src={logo} alt="Lumen" width={256} height={256} class="h-full w-full object-contain p-3" />
      </div>
      <div class="min-w-0">
        <p class="font-mono text-xs font-semibold tracking-widest text-aqua uppercase">{copy.version}</p>
        <h1 class="mt-2 font-display text-[2rem] leading-[1.1] font-semibold text-cream sm:text-5xl">{copy.title}</h1>
        <p class="mt-3 font-display text-lg text-lavender-100">{copy.tagline}</p>
        <p class="mt-1 text-sm text-lavender-200">{ownerName.full} · {copy.role}</p>
        <p class="callout mt-5 rounded-2xl border-2 border-aqua/35 bg-night-950/45 px-4 py-3 text-[0.95rem] leading-relaxed text-aqua-100">{copy.callout}</p>
        <button
          type="button"
          data-print
          class="print-btn mt-5 inline-flex cursor-pointer items-center gap-2 rounded-full bg-cream px-5 py-2.5 font-mono text-xs font-semibold text-night-900 transition-transform hover:-translate-y-0.5"
        >
          {copy.print}
        </button>
      </div>
    </section>

    <div class="doc-grid mt-10 lg:grid lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-12">
      <aside class="toc-wrap">
        <details class="toc-mobile mb-8 rounded-2xl border-2 border-lavender-200/30 bg-night-950/45 lg:hidden">
          <summary class="cursor-pointer px-4 py-3 font-mono text-xs font-semibold tracking-widest text-cream uppercase">{copy.toc}</summary>
          <ol class="toc-list px-4 pb-4">
            {headings.map((h) => (
              <li class:list={['toc-item', h.depth === 3 && 'toc-sub']}>
                <a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a>
              </li>
            ))}
          </ol>
        </details>
        <nav class="toc-desktop sticky top-6 hidden max-h-[calc(100svh-3rem)] overflow-y-auto pr-2 lg:block" aria-label={copy.toc}>
          <p class="mb-3 font-mono text-xs font-semibold tracking-widest text-lavender-200 uppercase">{copy.toc}</p>
          <ol class="toc-list">
            {headings.map((h) => (
              <li class:list={['toc-item', h.depth === 3 && 'toc-sub']}>
                <a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>

      <article class="prose-lumen" lang="es" data-doc>
        <Content />
      </article>
    </div>
  </div>

  <script>
    const doc = document.querySelector('[data-doc]');
    if (doc) {
      const walker = document.createTreeWalker(doc, NodeFilter.SHOW_TEXT);
      const nodes: Text[] = [];
      while (walker.nextNode()) nodes.push(walker.currentNode as Text);
      const re = /\b(zhenshis?|schülers?)\b/gi;
      for (const node of nodes) {
        const value = node.nodeValue ?? '';
        if (!re.test(value)) continue;
        re.lastIndex = 0;
        const parent = node.parentElement;
        if (!parent || parent.closest('h1, h2, h3, h4')) continue;
        const frag = document.createDocumentFragment();
        let last = 0;
        for (const m of value.matchAll(re)) {
          const at = m.index ?? 0;
          frag.append(value.slice(last, at));
          const mark = document.createElement('span');
          mark.className = 'term';
          mark.textContent = m[0];
          frag.append(mark);
          last = at + m[0].length;
        }
        frag.append(value.slice(last));
        node.replaceWith(frag);
      }
    }

    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc]'));
    const targets = links
      .map((a) => document.getElementById(a.dataset.toc ?? ''))
      .filter((el): el is HTMLElement => !!el)
      .filter((el, i, arr) => arr.indexOf(el) === i);
    const setActive = (slug: string) => {
      for (const a of links) {
        if (a.dataset.toc === slug) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      }
      const current = document.querySelector('.toc-desktop [aria-current="true"]');
      if (current) current.scrollIntoView({ block: 'nearest' });
    };
    if (targets.length) {
      const update = () => {
        let active = targets[0];
        for (const el of targets) {
          if (el.getBoundingClientRect().top <= 140) active = el;
          else break;
        }
        setActive(active.id);
      };
      let ticking = false;
      window.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            update();
            ticking = false;
          });
        },
        { passive: true },
      );
      update();
    }

    document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
    document.querySelectorAll('.toc-mobile a').forEach((a) =>
      a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')),
    );
  </script>
</BaseLayout>

<style is:global>
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid color-mix(in srgb, var(--color-lavender-200) 25%, transparent);
  }
  .toc-item a {
    display: block;
    padding: 0.28rem 0 0.28rem 0.9rem;
    margin-left: -2px;
    border-left: 2px solid transparent;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    line-height: 1.35;
    color: var(--color-lavender-200);
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
  }
  .toc-item:not(.toc-sub) a {
    font-weight: 600;
    margin-top: 0.35rem;
    color: var(--color-lavender-100);
  }
  .toc-sub a {
    padding-left: 1.7rem;
    font-size: 0.8rem;
  }
  .toc-item a:hover {
    color: var(--color-cream);
  }
  .toc-item a[aria-current='true'] {
    color: var(--color-cream);
    border-left-color: var(--color-cream);
  }
  .toc-mobile summary::marker {
    color: var(--color-aqua);
  }

  .prose-lumen {
    max-width: 70ch;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-ink) 92%, transparent);
    overflow-wrap: break-word;
  }
  .prose-lumen > * + * {
    margin-top: 1.1rem;
  }
  .prose-lumen h2,
  .prose-lumen h3 {
    font-family: var(--font-display);
    color: var(--color-cream);
    line-height: 1.2;
    scroll-margin-top: 1.5rem;
  }
  .prose-lumen h2 {
    font-size: 1.9rem;
    font-weight: 600;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 2px dashed color-mix(in srgb, var(--color-lavender-200) 30%, transparent);
  }
  .prose-lumen > h2:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .prose-lumen h3 {
    font-size: 1.3rem;
    font-weight: 500;
    margin-top: 2.2rem;
    color: var(--color-water-200);
  }
  .prose-lumen strong {
    color: var(--color-cream-100);
    font-weight: 700;
  }
  .prose-lumen ul,
  .prose-lumen ol {
    padding-left: 1.4rem;
  }
  .prose-lumen ul {
    list-style: disc;
  }
  .prose-lumen ol {
    list-style: decimal;
  }
  .prose-lumen li + li {
    margin-top: 0.6rem;
  }
  .prose-lumen li::marker {
    color: var(--color-aqua);
  }
  .prose-lumen a {
    color: var(--color-aqua);
    text-decoration: underline;
  }
  .prose-lumen table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.92rem;
    line-height: 1.5;
    border: 2px solid color-mix(in srgb, var(--color-lavender-200) 30%, transparent);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--color-night-950) 45%, transparent);
  }
  .prose-lumen th,
  .prose-lumen td {
    padding: 0.7rem 0.9rem;
    text-align: left;
    vertical-align: top;
    min-width: 7rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-lavender-200) 18%, transparent);
  }
  .prose-lumen th {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-aqua);
    background: color-mix(in srgb, var(--color-night-700) 40%, transparent);
    white-space: nowrap;
  }
  .prose-lumen tbody tr:last-child td {
    border-bottom: 0;
  }
  .prose-lumen tbody tr:nth-child(even) td {
    background: color-mix(in srgb, var(--color-night-800) 35%, transparent);
  }
  .prose-lumen .term {
    color: var(--color-night-900);
    background: color-mix(in srgb, var(--color-cream) 88%, transparent);
    border-radius: 0.4rem;
    padding: 0.02em 0.35em;
    font-weight: 600;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .prose-lumen strong .term {
    background: var(--color-cream);
  }

  @media print {
    html,
    body {
      background: #fff !important;
      color: #111 !important;
    }
    .grain,
    .topbar,
    .toc-wrap,
    .print-btn {
      display: none !important;
    }
    .doc-grid {
      display: block !important;
    }
    .lumen-page {
      max-width: none;
      padding: 0;
    }
    .doc-head {
      background: #fff !important;
      border: 0 !important;
      padding: 0 0 1rem !important;
      color: #111 !important;
    }
    .doc-head * {
      color: #111 !important;
      background: transparent !important;
    }
    .doc-head .callout {
      border: 1px solid #999 !important;
    }
    .prose-lumen {
      max-width: none;
      font-size: 11pt;
      line-height: 1.55;
      color: #111;
    }
    .prose-lumen h2,
    .prose-lumen h3,
    .prose-lumen strong {
      color: #111;
    }
    .prose-lumen h2 {
      border-top-color: #999;
      break-after: avoid;
    }
    .prose-lumen h3 {
      break-after: avoid;
    }
    .prose-lumen table {
      display: table;
      color: #111;
      background: #fff;
      border-color: #999;
      break-inside: avoid;
    }
    .prose-lumen th,
    .prose-lumen td {
      color: #111;
      background: #fff !important;
      border-bottom-color: #ccc;
    }
    .prose-lumen .term {
      background: transparent;
      color: #111;
      padding: 0;
      font-weight: 700;
    }
    .prose-lumen a {
      color: #111;
    }
  }
</style>
