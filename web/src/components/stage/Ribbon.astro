---
import { presets, nextRibbonId, type Preset } from './palette';

interface Props {
  d: string;
  p: string | Preset;
  k?: number;
  ns?: boolean;
  axis?: 'x' | 'y';
  op?: number;
}

const { d, p, k = 1, ns = false, axis = 'y', op } = Astro.props;
const preset = typeof p === 'string' ? presets[p] : p;
const id = nextRibbonId();
const shift = (o?: number) => (o ? (axis === 'x' ? `translate(${o * k} 0)` : `translate(0 ${o * k})`) : undefined);
---

<g fill="none" stroke-linecap="round" stroke-linejoin="round" opacity={op}>
  <defs>
    <path id={id} d={d} vector-effect={ns ? 'non-scaling-stroke' : undefined} />
  </defs>
  {preset.map((s) =>
    ns ? (
      <use
        href={`#${id}`}
        stroke={s.c}
        transform={shift(s.o)}
        opacity={s.op}
        style={`stroke-width:calc(var(--k) * ${s.w}px)${s.dash ? `;stroke-dasharray:${s.dash.map((v) => `calc(var(--k) * ${v}px)`).join(' ')}` : ''}`}
      />
    ) : (
      <use
        href={`#${id}`}
        stroke={s.c}
        stroke-width={s.w * k}
        stroke-dasharray={s.dash ? s.dash.map((v) => v * k).join(' ') : undefined}
        transform={shift(s.o)}
        opacity={s.op}
      />
    ),
  )}
</g>
