---
import '@fontsource-variable/fredoka';
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/jetbrains-mono';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const title = Astro.props.title ?? t['meta.title'];
const description = Astro.props.description ?? t['meta.description'];
const altEs = getRelativeLocaleUrl('es');
const altEn = getRelativeLocaleUrl('en');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1B1D4F" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
    <link rel="alternate" hreflang="es" href={altEs} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altEs} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="min-h-svh overflow-x-hidden">
    <slot />
    <div class="grain" aria-hidden="true"></div>
    <script>
      import Lenis from 'lenis';

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce) {
        new Lenis({ autoRaf: true, anchors: true, lerp: 0.1 });
      }
    </script>
  </body>
</html>
